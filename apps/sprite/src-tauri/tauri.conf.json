{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucy Sprite",
  "mainBinaryName": "lucy-sprite",
  "identifier": "io.github.ajmerr.lucy.sprite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "sprite",
        "title": "Lucy",
        "width": 128,
        "height": 128,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}

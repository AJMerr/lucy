# Rust
/target/

# Node / Tauri (apps/desktop)
node_modules/
dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# The `lucy` sidecar the release workflow puts in the bundles.
apps/desktop/src-tauri/binaries/

# Nix
/result
/result-*
.direnv/

# Local runtime data — never commit
*.sqlite
*.sqlite3
.env
.env.*

# Sprite packs are user-supplied and live outside the repo
# (default: <data dir>/lucy/packs). Only the built-in ones are tracked.
/packs/*
!/packs/default/
!/packs/placeholder/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Generated by the Tauri build from build.rs.
/apps/desktop/src-tauri/permissions/autogenerated/
